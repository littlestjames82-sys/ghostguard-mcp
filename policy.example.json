{"rules":[{"effect":"deny","id":"no-spend-ever","locked":true,"note":"Locked team rule: this proxy never spends. mergePolicyDocs carries it verbatim; an overlay rule reusing this id is dropped.","when":"permission_class == 'SPEND'"},{"effect":"deny","id":"no-delete-ever","locked":true,"note":"Locked team rule: deletes never run through this proxy.","when":"permission_class == 'DELETE'"},{"effect":"hand_off","handoff_to":"owner","id":"publish-handoff","note":"Publishing is a different approver's call, not this run's.","when":"permission_class == 'PUBLISH'"},{"effect":"ask","id":"comms-ask","when":"permission_class == 'COMMUNICATE' && approved == false"},{"effect":"ask","id":"execute-ask","when":"permission_class == 'EXECUTE' && approved == false"},{"effect":"ask","id":"network-write-ask","when":"permission_class == 'NETWORK_WRITE' && approved == false"},{"effect":"ask","id":"deploy-ask","when":"permission_class == 'DEPLOY' && approved == false"},{"effect":"allow","id":"approved-actions-allow","note":"A carried approval (exact tool + arguments hash in the approvals file) satisfies the ask rules above. Deny and hand_off tiers still outrank this.","when":"approved == true"},{"effect":"allow","id":"allow-read","when":"permission_class == 'READ'"},{"effect":"allow","id":"allow-write-local","when":"permission_class == 'WRITE_LOCAL'"}]}